{
  "name": "bare-lego",
  "version": "0.1.0",
  "description": "Drive a LEGO Technic Hub over BLE from Bare",
  "exports": {
    "./package": "./package.json",
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "remote.js",
    "lib"
  ],
  "scripts": {
    "start": "bare index.js",
    "remote": "bare remote.js",
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonygo/bare-lego.git"
  },
  "author": "Tony Gorez",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/tonygo/bare-lego/issues"
  },
  "homepage": "https://github.com/tonygo/bare-lego#readme",
  "dependencies": {
    "bare-bluetooth": "^0.3.0",
    "bare-events": "^2.9.2",
    "bare-http1": "^4.6.1",
    "bare-lwp3": "file:../bare-lwp3",
    "bare-os": "^3.9.3",
    "bare-tty": "^5.2.1"
  },
  "devDependencies": {
    "lunte": "^1.7.0",
    "prettier": "^3.9.1",
    "prettier-config-holepunch": "^2.0.0"
  }
}
